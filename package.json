{
  "scripts": {
    "test:js": "vitest run tests/js",
    "lint:js": "eslint \"static/js/**/*.js\" \"tests/js/**/*.js\"",
    "lint:js:fix": "npm run lint:js -- --fix",
    "format": "prettier --write \"static/js/**/*.js\" \"tests/js/**/*.js\"",
    "format:check": "prettier --check \"static/js/**/*.js\" \"tests/js/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "build:frontend": "vite build",
    "dev:vite": "vite"
  },
  "devDependencies": {
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "wavesurfer.js": "^7.12.2"
  }
}
