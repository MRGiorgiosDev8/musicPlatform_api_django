{
  "scripts": {
    "test:js": "vitest run tests/js",
    "lint:js": "eslint \"static/js/**/*.js\" \"tests/js/**/*.js\"",
    "lint:js:fix": "npm run lint:js -- --fix",
    "format": "prettier --write \"static/js/**/*.{js,ts}\" \"tests/js/**/*.{js,ts}\"",
    "format:check": "prettier --check \"static/js/**/*.{js,ts}\" \"tests/js/**/*.{js,ts}\"",
    "build:legacy": "node scripts/build-legacy.mjs",
    "check:legacy": "node scripts/check-legacy.mjs",
    "typecheck": "tsc --noEmit",
    "build:frontend": "vite build",
    "dev:vite": "vite",
    "dev:django": "uvicorn music_project.asgi:application --reload",
    "dev:vite:watch": "vite build --watch",
    "start": "concurrently -k -n django,vite -c auto \"npm:dev:django\" \"npm:dev:vite:watch\"",
    "vendor:icons": "node scripts/vendor-icons.mjs"
  },
  "devDependencies": {
    "bootstrap-icons": "^1.11.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.27.7",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "wavesurfer.js": "^7.12.2"
  }
}
